<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" spacing="10.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ni.uam.edu.sesion4.GradeController">

   <children>
      <Label text="Registro de notas" textFill="#0099ab">
         <padding>
            <Insets bottom="5.0" top="5.0" />
         </padding>
         <font>
            <Font name="System Bold Italic" size="18.0" />
         </font>
      </Label>
      <Label text="Nombre completo:" textFill="#3400db">
         <font>
            <Font name="System Bold" size="12.0" />
         </font>
      </Label>
      <TextField fx:id="txtName" />
      <Label text="Carrera:" textFill="#3400db">
         <font>
            <Font name="System Bold" size="12.0" />
         </font>
      </Label>
      <TextField fx:id="txtCareer" />
      <Label text="Nota" textFill="#3400db">
         <font>
            <Font name="System Bold" size="12.0" />
         </font>
      </Label>
      <TextField fx:id="txtGrades" />
      <Label fx:id="lblCountGrade" text="Registros guardados:" textFill="#d000ff">
         <font>
            <Font name="System Bold Italic" size="12.0" />
         </font>
      </Label>
      <Button fx:id="btnSave" mnemonicParsing="false" onAction="#SaveButtonAction" prefHeight="40.0" prefWidth="100.0" style="-fx-background-radius: 20;" text="Guardar" />
   </children>
   <padding>
      <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
   </padding>
</VBox>
